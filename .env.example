# Environment variables for Tree Ascension
# Copy to .env.local and customize values

# Adsterra Monetization
VITE_ADSTERRA_PUBLISHER_ID=5657609
VITE_ENABLE_ADSTERRA=true

# Analytics (empty value falls back to the built-in default)
VITE_CLARITY_ID=
VITE_GA4_ID=
VITE_GTM_ID=
VITE_GTM_ENABLED=false
VITE_GTM_GA4_ID=
VITE_COUNTER_ID=
VITE_COUNTER_UTCOFFSET=-3
VITE_ANALYTICS_ENABLED=true
# Legacy fallbacks still read by the config (uncomment to override)
# VITE_GA_MEASUREMENT_ID=
# VITE_COUNTER_DEV_ID=
